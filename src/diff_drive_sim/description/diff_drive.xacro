<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">
    <!-- Include Colours & Inertia Macros -->
    <xacro:include filename="inertial_macros.xacro"/>

    <!-- Links -->
    <link name="base_link"></link>

    <link name='chassis'>
        <visual>
            <geometry>
                <box size="2.0 1.0 0.5"/>
            </geometry>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
        <collision name='collision'>
            <geometry>
                <box size="2.0 1.0 0.5"/>
            </geometry>
            <origin xyz="0.5 0 0.4" rpy="0 0 0"/>
        </collision>
        <xacro:inertial_box mass="5.0" x="2.0" y="1.0" z="0.5">
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name='left_wheel'>
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.4"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision name='collision'>
            <geometry>
                <cylinder length="0.2" radius="0.4"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.2" radius="0.4">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name='right_wheel'>
        <visual>
            <geometry>
                <cylinder length="0.2" radius="0.4"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision name='collision'>
            <geometry>
                <cylinder length="0.2" radius="0.4"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:inertial_cylinder mass="2.0" length="0.2" radius="0.4">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name='caster_wheel'>
        <visual>
            <geometry>
                <sphere radius="0.15"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black"/>
        </visual>
        <collision name='collision'>
            <geometry>
                <sphere radius="0.15"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:inertial_sphere mass="0.5" radius="0.15">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <!-- Pen link -->
    <link name="pen_link">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.4"/>
            </geometry>
            <origin xyz="0 0 -0.2"/>
            <material name="blue"/>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.4"/>
            </geometry>
        </collision>

        <xacro:inertial_cylinder mass="0.05" length="0.4" radius="0.03">
            <origin xyz="0 0 0"/>
        </xacro:inertial_cylinder>

    </link>
    

    <!-- Joints -->
    <joint name="chassis_joint" type="fixed">
        <origin xyz ="0 0 0.4" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="chassis"/>
    </joint>

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz ="0 0.6 0" rpy="-1.57 0 0"/>
        <parent link="chassis"/>
        <child link="left_wheel"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz ="0 -0.6 0" rpy="1.57 0 0"/>
        <parent link="chassis"/>
        <child link="right_wheel"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="caster_joint" type="fixed">
        <origin xyz ="1.2 0 -0.25 " rpy="0 0 0"/>
        <parent link="chassis"/>
        <child link="caster_wheel"/>
    </joint>

    <!-- Pen lift joint -->
    <joint name="pen_joint" type="prismatic">
        <parent link="chassis"/>
        <child link="pen_link"/>

        <origin xyz="1.0 0 -0.25" rpy="0 0 0"/>

        <axis xyz="0 0 1"/>

        <limit
           lower="-0.05"
           upper="0.05"
           effort="10"
           velocity="0.1"/>
    </joint>

   <!-- <joint name="rod_left_joint" type="revolute">
        <parent link="chassis"/>
        <child link="rod_left"/>
        <origin xyz="0.3 0.2 0" rpy="0 1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.8" upper="0.8" effort="5" velocity="1"/>
    </joint>


    <joint name="rod_right_joint" type="revolute">
        <parent link="chassis"/>
        <child link="rod_right"/>
        <origin xyz="0.3 -0.2 0" rpy="0 1.57 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.8" upper="0.8" effort="5" velocity="1"/>
    </joint>

    <joint name="rod_left_pen_joint" type="revolute">
        <parent link="rod_left"/>
        <child link="pen_holder"/>
        <origin xyz="0 0 -0.5"/>
        <axis xyz="0 1 0"/>
    </joint>


    <joint name="rod_right_pen_joint" type="revolute">
        <parent link="rod_right"/>
        <child link="pen_holder"/>
        <origin xyz="0 0 -0.5"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="pen_tip_joint" type="fixed">
        <parent link="pen_holder"/>
        <child link="pen_tip"/>
        <origin xyz="0 0 -0.2"/>
    </joint> 
    -->

    <!--
    Friction Coefficients of links
        - High friction for wheels to prevent slipping
        - Low friction for caster wheel to allow slipping
          (since caster joint is fixed and not pivoted)
    -->
    <gazebo reference="left_wheel">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
    </gazebo>

    <gazebo reference="caster_wheel">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>

    <!-- Plugins to control wheel joints using topics -->
    
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>   
            <right_joint>right_wheel_joint</right_joint> 
            <wheel_separation>1.2</wheel_separation>  <wheel_radius>0.4</wheel_radius>           
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>/cmd_vel</topic>
        </plugin>
    </gazebo>

    <gazebo reference="chassis">
        <visual>
            <material>
                <ambient>0.0 0.0 1.0 1.0</ambient>  <diffuse>0.0 0.0 1.0 1.0</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="left_wheel">
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1.0</ambient>  <diffuse>0.2 0.2 0.2 1.0</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="right_wheel">
        <visual>
            <material>
                <ambient>0.2 0.2 0.2 1.0</ambient>
                <diffuse>0.2 0.2 0.2 1.0</diffuse>
            </material>
        </visual>
    </gazebo>

    <ros2_control name="GazeboSystem" type="system">

        <hardware>
           <plugin>gz_ros2_control/GazeboSystem</plugin>
        </hardware>
 
        <joint name="pen_joint">
           <command_interface name="position"/>
           <state_interface name="position"/>
           <state_interface name="velocity"/>
        </joint>

    </ros2_control>
</robot>